{
  "schema": "VRgame.Config.CombatNumeric",
  "version": "v1-skeleton",
  "_meta": {
    "tableId": "combat_numeric",
    "displayName": "战斗数值表",
    "layer": "split",
    "frontendKeys": ["playerBaseByLevel", "weaponBase", "skillNumeric", "gpRules", "spRules", "mpRules", "damageFormulas", "balanceTargets"],
    "backendKeys": ["ttkModel", "enemyBudget", "levelEconomy", "combatAuthority"],
    "sourceOfTruth": [
      "docs/数值/数值配置_前端_v1.json",
      "docs/数值/数值配置_后端_v1.json"
    ],
    "notes": "可配置战斗权威值；导入时前端读表现/导入字段，后端读 TTK 与 enemyBudget。本骨架示例行对齐 v1，完整曲线仍以 v1 双表为准。",
    "fields": {
      "playerBaseByLevel[]": "level,hp,mp,sp,atk,matk,def,mdef,crit,critDmg",
      "weaponBase[]": "weaponId,atk,matk,speedTier,gpOnHit",
      "skillNumeric[]": "skillId,mp,sp,gp,cd,chargeTime,mul,formulaId,+optional hitCount/aoeRadius/impactRadius",
      "enemyBudget[]": "id,level,hp,atk,matk,def,mdef,ttkSec,role,fightLevel,phaseHpPct?",
      "levelEconomy[]": "levelId,timeLimitSec,winRewardSilver,loseRewardSilver,expWin,expLose,respawnCount",
      "ttkModel": "avgSlashMul,theoryHitsPerSecMid,trash/eliteBoss factors,exprs"
    }
  },
  "ttkModel": {
    "avgSlashMul": 1.15,
    "theoryHitsPerSecMid": 1.2,
    "trash": {
      "vrHitFactor": 0.85,
      "uptime": 0.95,
      "dpsExpr": "slashHit * 1.2 * 0.85 * 0.95"
    },
    "eliteBoss": {
      "vrHitFactor": 0.75,
      "uptime": 0.85,
      "skillUpliftByRole": {
        "elite": 1.2,
        "bossEarly": 1.18,
        "bossMid": 1.15,
        "bossLate": 1.12,
        "bossFinal": 1.1
      }
    },
    "slashHitExpr": "(atk+weaponAtk) * 1.15 * (1-def/(def+50)) * (1+crit*(critDmg-1))",
    "phaseInvulnExcluded": true
  },
