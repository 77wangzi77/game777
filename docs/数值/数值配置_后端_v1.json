    "ttkModel": {
      "avgSlashMul": 1.15,
      "theoryHitsPerSecMid": 1.2,
      "trash": {
        "vrHitFactor": 0.85,
        "uptime": 0.95,
        "dpsExpr": "slashHit * 1.2 * 0.85 * 0.95"
      },
      "eliteBoss": {
        "vrHitFactor": 0.75,
        "uptime": 0.85,
        "skillUpliftByRole": {
          "elite": 1.2,
          "bossEarly": 1.18,
          "bossMid": 1.15,
          "bossLate": 1.12,
          "bossFinal": 1.1
        },
        "dpsExpr": "slashHit * 1.2 * vrHitFactor * uptime * skillUplift"
      },
      "slashHitExpr": "(atk+weaponAtk) * 1.15 * (1-def/(def+50)) * (1+crit*(critDmg-1))",
      "ultTotalExpr": "(atk+weaponAtk) * 1.35 * chargeScale * hitCount * (1-def/(def+50)) * critExpect",
      "phaseInvulnExcluded": true
    }
  },
