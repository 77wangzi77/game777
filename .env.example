# Sandbox restricted key from `stripe sandboxes create`. Never commit a real key.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/webhooks` or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
PORT=3000

# Optional invoice rendering template IDs created in the Dashboard.
# Templates cannot be created through the API.
INVOICE_TEMPLATE_GAME_DEVELOPMENT=
INVOICE_TEMPLATE_INDUSTRIAL_DESIGN=
INVOICE_TEMPLATE_CONSULTING=
INVOICE_TEMPLATE_AI_SERVICES=
